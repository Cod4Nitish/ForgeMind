# ── Reasoning model (server-only) ─────────────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# ── Swytchcode execution layer ────────────────────────────────
# Locally, run `swytchcode login` — no variable is needed.
# Headless environments (CI, Vercel) authenticate with a service token.
SWYTCHCODE_TOKEN=
# Optional override for the swytchcode binary path.
SWYTCHCODE_BIN=

# ── Trusted destinations (configuration, not secrets) ─────────
# The only repository ForgeMind reads issues from, as owner/repo.
FORGEMIND_GITHUB_REPOSITORY=
