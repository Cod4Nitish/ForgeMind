# ── Reasoning model (server-only) ─────────────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# ── Swytchcode execution layer ────────────────────────────────
# Locally, run `swytchcode login` — no variable is needed.
# Headless environments (CI, Vercel) authenticate with a service token.
SWYTCHCODE_TOKEN=
# Optional override for the swytchcode binary path.
SWYTCHCODE_BIN=

# ── Trusted destinations (configuration, not secrets) ─────────
# The only repository ForgeMind reads issues from, as owner/repo.
FORGEMIND_GITHUB_REPOSITORY=
# Jira project key tasks are created in (e.g. FORGE). Use a test project.
FORGEMIND_JIRA_PROJECT=
# Slack channel for notifications: channel ID (C0123ABCD) or "#channel-name".
# Quote names that start with "#" — unquoted, dotenv reads "#" as a comment
# and the value becomes empty. Example: FORGEMIND_SLACK_CHANNEL="#forgemind-demo"
# Use a dedicated test channel.
FORGEMIND_SLACK_CHANNEL=
