# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
dist/
build/

# testing
coverage/

# env files — secrets stay local; only the placeholder template is committed
.env
.env.*
!.env.example

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# swytchcode — tooling.json (enabled tools) is committed; runtime state is not
.swytchcode/**/*.lock
.swytchcode/audit/
.swytchcode/logs/

# credentials
*.pem
*.key
credentials.json
